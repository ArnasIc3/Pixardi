@{
    ViewData["Title"] = "Admin Canvas";
}

<link rel="stylesheet" href="~/css/canvas.css" asp-append-version="true" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" />

<div class="container-fluid" id="canvasApp" data-is-admin="true">
    <div class="canvas-header">
        <h1>Admin Canvas Control</h1>
        <div class="admin-controls">
            <button id="clearCanvasBtn" class="btn btn-danger">
                <i class="fas fa-trash"></i> Clear Canvas
            </button>
            <a href="@Url.Action("Index", "Canvas")" class="btn btn-secondary">
                <i class="fas fa-eye"></i> View Normal Canvas
            </a>
        </div>
    </div>

    <div class="canvas-layout">
        <div class="canvas-sidebar">
            <div class="admin-mode-indicator">
                <h6><i class="fas fa-crown"></i> Admin Mode</h6>
            </div>

            <div class="admin-tools">
                <h6>Tools</h6>
                <button id="deleteModeBtn" class="tool-btn" data-mode="delete">
                    <i class="fas fa-eraser"></i> Delete Mode
                </button>
                <button id="addModeBtn" class="tool-btn active" data-mode="add">
                    <i class="fas fa-paint-brush"></i> Add Mode
                </button>
            </div>

            <div class="admin-tools">
                <h6>Image Import</h6>
                <div class="image-import-controls">
                    <input type="file" id="imageFileInput"
                        accept="image/png,image/jpeg,image/jpg,image/gif,image/bmp,image/webp" style="display: none;">
                    <button id="selectImageBtn" class="tool-btn">
                        <i class="fas fa-image"></i> Select Image
                    </button>
                    <small style="display: block; color: rgba(255, 255, 255, 0.6); font-size: 10px; margin-top: 5px;">
                    </small>

                    <div id="imagePreviewSection" style="display: none; margin-top: 10px;">
                        <img id="imagePreview" style="max-width: 100%; border: 1px solid #ddd; border-radius: 4px;">

                        <div style="margin-top: 10px;">
                            <label style="display: block; font-size: 12px; margin-bottom: 5px;">
                                Start X (Grid)
                                <input type="number" id="startXInput" value="0" min="0" max="199"
                                    style="width: 100%; padding: 5px; margin-top: 3px;">
                            </label>

                            <label style="display: block; font-size: 12px; margin-bottom: 5px; margin-top: 8px;">
                                Start Y (Grid)
                                <input type="number" id="startYInput" value="0" min="0" max="119"
                                    style="width: 100%; padding: 5px; margin-top: 3px;">
                            </label>

                            <label style="display: block; font-size: 12px; margin-bottom: 5px; margin-top: 8px;">
                                Max Width (pixels)
                                <input type="number" id="maxWidthInput" value="50" min="1" max="200"
                                    style="width: 100%; padding: 5px; margin-top: 3px;">
                            </label>
                        </div>

                        <button id="importImageBtn" class="tool-btn"
                            style="width: 100%; margin-top: 10px; background: #28a745;">
                            <i class="fas fa-upload"></i> Import to Canvas
                        </button>

                        <button id="cancelImageBtn" class="tool-btn"
                            style="width: 100%; margin-top: 5px; background: #6c757d;">
                            <i class="fas fa-times"></i> Cancel
                        </button>

                        <div id="importStatus" style="margin-top: 10px; font-size: 12px;"></div>
                    </div>
                </div>
            </div>

            <h2 class="canvas-eyebrow">Color Picker</h2>
            <div class="color-wheel-meta">
                <span id="colorHex">#000000</span>
            </div>

            <div class="color-wheel-wrapper">
                <div class="color-wheel-visual">
                    <canvas id="colorWheelCanvas" width="360" height="360" aria-label="Color selection wheel"></canvas>
                </div>
            </div>

            <div class="color-info">
                <p>Current Color</p>
                <span id="currentColor" class="current-color-display"></span>
            </div>

            <div class="mode-info">
                <p>Mode: <span id="currentMode">Add</span></p>
                <small>Admin - No cooldowns</small>
            </div>
        </div>

        <div class="canvas-main">
            <div class="canvas-controls">
                <button type="button" id="zoomInBtn" class="zoom-btn">+</button>
                <button type="button" id="zoomResetBtn" class="zoom-btn">Reset</button>
                <button type="button" id="zoomOutBtn" class="zoom-btn">-</button>
            </div>
            <div class="canvas-container">
                <canvas id="drawingCanvas" width="1000" height="600"></canvas>
            </div>

            <div class="admin-status">
                <p class="text-success">✅ Admin privileges active - No cooldowns</p>
            </div>
        </div>
    </div>
</div>

<form>
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script src="https://unpkg.com/@@microsoft/signalr@latest/dist/browser/signalr.min.js"></script>
    <script src="~/js/canvas.js" asp-append-version="true"></script>
}